{
  "expo": {
    "name": "课序",
    "slug": "classflow",
    "version": "0.1.8",
    "sdkVersion": "56.0.0",
    "icon": "./assets/icon.png",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "scheme": "classflow",
    "plugins": ["./scripts/with-android-gradle.cjs"],
    "ios": { "supportsTablet": true, "bundleIdentifier": "app.classflow.mobile", "infoPlist": { "CADisableMinimumFrameDurationOnPhone": true } },
    "android": {
      "package": "app.classflow.mobile",
      "versionCode": 9,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-foreground.png",
        "monochromeImage": "./assets/android-foreground.png",
        "backgroundColor": "#364BB6"
      }
    },
    "web": { "bundler": "metro", "name": "课序 ClassFlow", "description": "安排课程，也为自己留一点空白。" }
  }
}
