{
  "name": "classflow",
  "version": "0.1.21",
  "private": true,
  "author": "Inno-Mon Studio",
  "type": "module",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web --port 8081",
    "android": "expo run:android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:browser": "node --experimental-strip-types tests/timetable-browser.mjs",
    "test:embedded": "node --experimental-strip-types tests/timetable-embedded-browser.mjs",
    "test:compat": "node --experimental-strip-types tests/timetable-compat-browser.mjs",
    "test:hainnu": "node --experimental-strip-types tests/timetable-hainnu-browser.mjs",
    "test:canvas": "node --experimental-strip-types tests/canvas-browser.mjs",
    "test:layout": "node --experimental-strip-types tests/layout-browser.mjs",
    "test:panels": "node --experimental-strip-types tests/panels-browser.mjs",
    "build:android": "expo export --platform android --output-dir dist/android",
    "build:web": "expo export --platform web",
    "preview:web": "node scripts/preview.mjs"
  },
  "dependencies": {
    "@expo/metro-runtime": "~56.0.21",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~56.0.0",
    "expo-blur": "~56.0.4",
    "expo-document-picker": "~56.0.4",
    "expo-file-system": "~56.0.11",
    "expo-glass-effect": "~56.0.4",
    "expo-haptics": "~56.0.3",
    "expo-linear-gradient": "~56.0.4",
    "expo-notifications": "~56.0.26",
    "expo-sharing": "~56.0.27",
    "expo-symbols": "~56.0.7",
    "expo-system-ui": "~56.0.5",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "~0.85.0",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-webview": "^13.16.1",
    "react-native-worklets": "0.8.3"
  },
  "devDependencies": {
    "@types/react": "~19.2.0",
    "playwright": "^1.62.1",
    "typescript": "~5.9.2"
  }
}
